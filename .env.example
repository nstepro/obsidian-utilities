# Copy to .env and fill in.

# Obsidian vault pointer (required)
# The absolute local path of your Obsidian vault. The publisher crawls ALL
# subdirectories for markdown files front-matter-tagged `publish: true`.
BASE_MD_DIR=C:/path/to/vault

# GCS bucket (optional; defaults to nstepro-sites)
GCS_BUCKET=nstepro-sites

# Auth: Application Default Credentials by default (`gcloud auth
# application-default login`). To use a service-account key file instead,
# point GOOGLE_APPLICATION_CREDENTIALS at it — the library picks it up
# automatically.
# GOOGLE_APPLICATION_CREDENTIALS=C:/keys/obsidian-publisher.json

# Git sync (all optional; enables git mirror for notes under GIT_PUBLISH_SUBDIR)
# Absolute path segments identifying the parent directory containing the notes
# to push to git (e.g. /ProductDocs/)
# GIT_PUBLISH_SUBDIR=/ProductDocs/
# Absolute local path of the git repository (e.g. C:/git/my-git-repo)
# GIT_REPO_ABSDIR=C:/git/my-git-repo
# Base URL used to build the frontmatter gitURL link for each file
# GIT_REPO_URL=https://github.com/myusername/my-git-repo/blob/main/docs
